#!name = 大师兄影视 · 去开屏广告
#!desc = 针对 iOS 大师兄影视的启动页广告，拦截 TopOn/AnyThink、Smartdigimkt、Sigmob、穿山甲、优量汇、快手和百度广告 SDK 的配置、竞价与上报域名。按域名拒绝，不需要 MITM 证书。
#!author = Codex
#!homepage = https://github.com/Wansensr/loon-plugins
#!system = iOS,iPadOS
#!system_version = 15
#!loon_version = 3.2.1(733)
#!date = 2026-10-23
#!tag = 去广告,影视
#!type = normal

[General]

[Rule]
# TopOn / AnyThink 聚合广告
